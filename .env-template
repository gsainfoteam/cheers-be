PORT=3000
# drizzle 쿼리 로그를 콘솔에 출력할지 (true 일 때만 출력, 비워두면 끔)
# QUERY_LOG=true

POSTGRES_PASSWORD=password
POSTGRES_USER=cheers
POSTGRES_DB=cheers
DATABASE_URL=postgresql://cheers:password@localhost:5432/cheers?schema=public&connect_timeout=300

SLACK_WEBHOOK_URL=CHANGE_TO_YOUR_SLACK_WEBHOOK_URL

# Mail (Gmail SMTP + Google 앱 비밀번호)
# 로컬에서는 비워두면 발송하지 않고 로그만 남김. NODE_ENV=production(Docker 이미지 기본값)에서 비어 있으면 서버가 뜨지 않음
MAIL_USER=CHANGE_TO_YOUR_GMAIL_ADDRESS
MAIL_APP_PASSWORD=CHANGE_TO_YOUR_GOOGLE_APP_PASSWORD
MAIL_FROM_NAME=취얼스
# 수신자에게 보이는 보내는 주소. 비우면 MAIL_USER를 씀
# MAIL_USER 계정의 Gmail "다른 주소에서 메일 보내기"에 등록·인증해야 From이 유지됨
MAIL_FROM_ADDRESS=

# JWT 서명 키(RS256)는 env로 받지 않음. 서버가 기동할 때 DB(jwt_signing_key)에서 읽고, 없으면 만들어 저장
# access token 수명 = 탈퇴 · 유형 변경 후에도 기존 토큰이 통과할 수 있는 최대 시간 (형식: 30m, 1h)
# ACCESS_TOKEN_EXPIRES_IN=1h
# refresh token 만료 일수 (양의 정수). 발급 시각 기준 고정이며 refresh해도 연장되지 않음
# REFRESH_TOKEN_EXPIRE_DAYS=180
# 가입을 마친 회원의 탈퇴 유예기간 (일, 0 이상 정수, 비워두면 30). 이 기간 안에 다시 로그인하면 탈퇴 취소,
# 지나면 매일 04:00(KST) 스케줄러가 삭제. 가입 중(pending)에 탈퇴하면 이 값과 관계없이 1일
# WITHDRAWAL_GRACE_DAYS=30

# Kakao alimtalk (솔라피)
# 하나라도 비어 있으면 production 포함 모든 환경에서 발송하지 않고 로그만 남김 (비즈 채널 · 템플릿 심사 전에도 배포 가능)
# SOLAPI_API_KEY=CHANGE_TO_YOUR_SOLAPI_API_KEY
# SOLAPI_API_SECRET=CHANGE_TO_YOUR_SOLAPI_API_SECRET
# SOLAPI_SENDER_PHONE=CHANGE_TO_YOUR_REGISTERED_SENDER_PHONE
# KAKAO_PF_ID=CHANGE_TO_YOUR_KAKAO_CHANNEL_PF_ID
# KAKAO_TEMPLATE_COFFEE_CHAT_REQUESTED=CHANGE_TO_YOUR_TEMPLATE_ID
# KAKAO_TEMPLATE_CONTACT_SHARED=CHANGE_TO_YOUR_TEMPLATE_ID

# 웹 서비스 주소. 커피챗 알림 메일의 요청 상세 링크에 씀 (끝의 / 없이)
# 로컬에서는 비워두면 링크 없이 발송. NODE_ENV=production에서 비어 있으면 서버가 뜨지 않음
WEB_BASE_URL=http://localhost:5173
# API를 브라우저에서 호출할 수 있는 프론트 origin (쉼표로 여러 개 가능, 스킴 포함 · 경로 없이, * 불가)
# 형식이 잘못되면 모든 환경에서 서버가 뜨지 않음. 비어 있으면 로컬은 전부 거부(경고 로그), NODE_ENV=production에서는 서버가 뜨지 않음
CORS_ALLOWED_ORIGINS=http://localhost:5173
# 현업자 목록 random 정렬의 섞는 기준이 바뀌는 주기 (분, 양의 정수, 비워두면 60). 같은 주기 안에서는 페이지를 넘겨도 순서 유지
# CHEERS_RANDOM_SEED_MINUTES=60

# OAuth. ID token의 aud 검증에 쓰는 client ID라 없으면 서버가 뜨지 않음 (쉼표로 여러 개 가능)
# Naver는 클라이언트가 보낸 access token으로 프로필 API를 호출하므로 서버 설정 불필요
GOOGLE_CLIENT_ID=CHANGE_TO_YOUR_GOOGLE_CLIENT_ID
# 지금은 Google 로그인만 열려 있어 미사용 (Apple 로그인을 열 때 필수)
# APPLE_CLIENT_ID=CHANGE_TO_YOUR_APPLE_SERVICE_ID
# 아래는 Apple 토큰 폐기 · code 교환을 도입할 때 사용 (지금은 미사용)
# APPLE_TEAM_ID=CHANGE_TO_YOUR_APPLE_TEAM_ID
# APPLE_KEY_ID=CHANGE_TO_YOUR_APPLE_KEY_ID
# APPLE_PRIVATE_KEY=CHANGE_TO_YOUR_APPLE_PRIVATE_KEY

# S3 private 버킷 (icarus-infra module "s3"). 자격증명은 SDK 기본 chain:
# 버킷 IAM user의 access key를 AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY로 (로컬은 ~/.aws도 가능, 배포는 K8s 주입)
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=gsainfoteam-icarus-cheers-private-staging
# AWS_ACCESS_KEY_ID=CHANGE_TO_YOUR_BUCKET_IAM_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=CHANGE_TO_YOUR_BUCKET_IAM_SECRET_ACCESS_KEY
# 조회용 presigned GET URL 수명 (초)
# S3_PRESIGNED_URL_EXPIRES_IN=600
# 업로드용 presigned PUT URL 수명 (초)
# S3_UPLOAD_URL_EXPIRES_IN=300
# 고아 파일 정리 (매주 일요일 04:30 KST). "true"일 때만 실제로 지우고, 아니면 후보를 로그로만 남김.
# DB와 다른 환경의 버킷을 연결한 상태로 켜면 파일이 전부 고아로 보이니 로컬에서는 켜지 말 것
# S3_ORPHAN_DELETE_ENABLED=false
# 한 번에 지울 최대 개수. 넘으면 이만큼 지우고 Slack으로 알림, 나머지는 다음 실행에서 지움
# S3_ORPHAN_MAX_DELETES=1000
# 오래된 파일 중 고아 비율이 이 값을 넘고 고아가 10개 이상이면 지우지 않고 Slack으로 알림 (0 초과 1 이하).
# 참조가 하나도 없을 때는 이 값과 상관없이 지우지 않음
# S3_ORPHAN_MAX_RATIO=0.5

# Swagger UI(/api-docs)와 OpenAPI JSON(/api-docs-json)을 열지 (true / false, 비워두면 꺼짐)
# 꺼져 있으면 경로를 등록하지 않아 둘 다 404. 인증 없이 열리므로 staging에만 true를 넣고 production에는 넣지 않음
# true · false 외의 값이면 모든 환경에서 서버가 뜨지 않음
# SWAGGER_ENABLED=true
