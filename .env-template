PORT=3000
LOG_PATH=./logs

POSTGRES_PASSWORD=password
POSTGRES_USER=cheers
POSTGRES_DB=cheers
DATABASE_URL=postgresql://cheers:password@localhost:5432/cheers?schema=public&connect_timeout=300

SLACK_WEBHOOK_URL=CHANGE_TO_YOUR_SLACK_WEBHOOK_URL

# Mail (Gmail SMTP + Google 앱 비밀번호)
# 로컬에서는 비워두면 발송하지 않고 로그만 남김. NODE_ENV=production(Docker 이미지 기본값)에서 비어 있으면 서버가 뜨지 않음
MAIL_USER=CHANGE_TO_YOUR_GMAIL_ADDRESS
MAIL_APP_PASSWORD=CHANGE_TO_YOUR_GOOGLE_APP_PASSWORD
MAIL_FROM_NAME=취얼스

# JWT (RS256). 없으면 서버가 뜨지 않음. 한 줄로 넣을 때는 줄바꿈을 \n 으로
# openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out jwt-private.pem
# openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHANGE_TO_YOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nCHANGE_TO_YOUR_PUBLIC_KEY\n-----END PUBLIC KEY-----"
# access token 수명 = 탈퇴 · 유형 변경 후에도 기존 토큰이 통과할 수 있는 최대 시간 (형식: 30m, 1h)
# ACCESS_TOKEN_EXPIRES_IN=1h
# refresh token 만료 일수 (양의 정수)
# REFRESH_TOKEN_EXPIRE_DAYS=30

# Kakao alimtalk (솔라피)
# 하나라도 비어 있으면 production 포함 모든 환경에서 발송하지 않고 로그만 남김 (비즈 채널 · 템플릿 심사 전에도 배포 가능)
# SOLAPI_API_KEY=CHANGE_TO_YOUR_SOLAPI_API_KEY
# SOLAPI_API_SECRET=CHANGE_TO_YOUR_SOLAPI_API_SECRET
# SOLAPI_SENDER_PHONE=CHANGE_TO_YOUR_REGISTERED_SENDER_PHONE
# KAKAO_PF_ID=CHANGE_TO_YOUR_KAKAO_CHANNEL_PF_ID
# KAKAO_TEMPLATE_COFFEE_CHAT_REQUESTED=CHANGE_TO_YOUR_TEMPLATE_ID
# KAKAO_TEMPLATE_CONTACT_SHARED=CHANGE_TO_YOUR_TEMPLATE_ID

# OAuth (로그인 구현 시 사용)
# GOOGLE_CLIENT_ID=CHANGE_TO_YOUR_GOOGLE_CLIENT_ID
# APPLE_CLIENT_ID=CHANGE_TO_YOUR_APPLE_SERVICE_ID
# APPLE_TEAM_ID=CHANGE_TO_YOUR_APPLE_TEAM_ID
# APPLE_KEY_ID=CHANGE_TO_YOUR_APPLE_KEY_ID
# APPLE_PRIVATE_KEY=CHANGE_TO_YOUR_APPLE_PRIVATE_KEY

# S3 private 버킷 (icarus-infra module "s3"). 자격증명은 SDK 기본 chain:
# 버킷 IAM user의 access key를 AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY로 (로컬은 ~/.aws도 가능, 배포는 K8s 주입)
AWS_S3_REGION=ap-northeast-2
AWS_S3_BUCKET_NAME=gsainfoteam-icarus-cheers-private-staging
# AWS_ACCESS_KEY_ID=CHANGE_TO_YOUR_BUCKET_IAM_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY=CHANGE_TO_YOUR_BUCKET_IAM_SECRET_ACCESS_KEY
# 조회용 presigned GET URL 수명 (초)
# S3_PRESIGNED_URL_EXPIRES_IN=600
# 업로드용 presigned PUT URL 수명 (초)
# S3_UPLOAD_URL_EXPIRES_IN=300
