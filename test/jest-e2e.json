{
  "moduleFileExtensions": ["js", "json", "ts"],
  "moduleNameMapper": {
    "^@src/(.*)$": "<rootDir>/../src/$1",
    "^@drizzle/(.*)$": "<rootDir>/../drizzle/$1"
  },
  "rootDir": ".",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "maxWorkers": 1,
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "testTimeout": 30000,
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
