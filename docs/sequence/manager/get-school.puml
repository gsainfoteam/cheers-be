@startuml get-manager-school
skinparam defaultFontName "Apple SD Gothic Neo", "Noto Sans CJK KR", sans-serif
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
skinparam BoxPadding 8
skinparam shadowing false
autonumber
hide footbox

title GET /api/manager/v1/school
caption CRB-43 · 학교 목록과 학교별 허용 이메일 도메인

actor Client
participant "ManagerGuard" as Guard
participant "SchoolDepartmentController" as Controller
participant "SchoolDepartmentService" as Service
participant "AdminSchoolRepository" as SchoolRepository
participant "AdminSchoolEmailDomainRepository" as DomainRepository
database PostgreSQL

Client -> Guard: GET /api/manager/v1/school\nAuthorization: Bearer <manager token>
ref over Client, Guard: ManagerGuard — flow/manager-guards.puml\n401 Missing access token / Token expired / Invalid token / Manager not found
Guard -> Controller: listSchools()
Controller -> Service: listSchools()
Service -> SchoolRepository: findAll()
SchoolRepository -> PostgreSQL: SELECT school ORDER BY pk
PostgreSQL --> SchoolRepository: rows
Service -> DomainRepository: findAll()
DomainRepository -> PostgreSQL: SELECT school_email_domain ORDER BY pk
PostgreSQL --> DomainRepository: rows
Service -> Service: 학교별로 도메인을 묶음
Service --> Controller: SchoolDto[]
Controller --> Client: 200 [{ pk, name, email_domains }]

@enduml
