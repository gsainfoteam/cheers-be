@startuml get-cheers-sent
skinparam defaultFontName "Apple SD Gothic Neo", "Noto Sans CJK KR", sans-serif
skinparam responseMessageBelowArrow true
skinparam sequenceMessageAlign left
skinparam maxMessageSize 260
skinparam BoxPadding 8
skinparam shadowing false
autonumber
hide footbox

title GET /api/v1/cheers/sent
caption CRB-37 · 내가 보낸 커피챗 요청 목록 (최근 요청 순)

actor Client
participant "UserGuard\n+ UserTypeGuard" as Guard
participant "ValidationPipe" as Pipe
participant "CheersStudentController" as Controller
participant "CheersStudentService" as Service
participant "CoffeeChatRequestRepository" as CoffeeChatRequestRepository
database PostgreSQL

Client -> Guard: GET /api/v1/cheers/sent?page=&size=\nAuthorization: Bearer <access token>
ref over Client, Guard
  UserGuard, UserTypeGuard — flow/auth-guards.puml
  @UserTypes(["student"]). 가입을 마친(active) 재학생만
  401 Missing access token / Token expired / Invalid token
  403 Signup is not completed / User type not allowed (현업자)
end ref
Guard -> Pipe: 통과
alt query 검증 실패 (page < 1, size < 1 또는 > 50, 정수가 아님)
  Pipe -[#red]-> Client: 400 (class-validator 메시지)
end
note right of Pipe: 기본값 page = 1, size = 20
Pipe -> Controller: getSentList(query, user)
Controller -> Service: getSentList(userPk, query)

par 동시에 조회 — 같은 조건
  Service -> CoffeeChatRequestRepository: findSentPage(userPk, offset, limit)
  CoffeeChatRequestRepository -> PostgreSQL: SELECT r.pk, r.message, r.created_at,\nr.graduated_viewed_at, r.contact_shared_at,\ng.pk, gp.nickname, gp.company, gp.job\nFROM coffee_chat_request r\nJOIN student s ON s.pk = r.student_pk AND s.user_pk = ?\nJOIN graduated g JOIN graduated_profile gp\nORDER BY r.created_at DESC, r.pk DESC LIMIT OFFSET
  note right
    상대 현업자가 탈퇴했어도 요청 기록은 보여 줌
    (탈퇴 정책상 graduated_profile · 요청 기록은 보관)
  end note
  CoffeeChatRequestRepository --> Service: rows
else
  Service -> CoffeeChatRequestRepository: (count)
  CoffeeChatRequestRepository -> PostgreSQL: SELECT count(*) (같은 FROM · WHERE)
  CoffeeChatRequestRepository --> Service: total
end
note right of Service: 트랜잭션 없음 (조회만)

Service -> Service: status 계산\ncontact_shared_at 있음 → "contact_shared"\ngraduated_viewed_at 있음 → "viewed"\n그 외 → "requested"
Service --> Controller: { items, page, size, total }
Controller --> Client: 200 { items: SentRequestDto[], page, size, total }

@enduml
